# Local environments, machine state and compiled caches only.
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
Thumbs.db
.DS_Store
# Scientific checkpoints, smoke outputs and preserved imports are intentional.
# Raw simulator monitors downloaded from Hugging Face (large; provenance in outputs/*/..._manifest.csv)
data/raw/
# Week 19 intermediate pickles (regenerated by python -m src.week19_temporal_audit labels/series/tables)
outputs/week19_temporal_regime_audit/_cache/
# Week 20 resumable caches (per-run ledgers and per-step predictions; regenerated by python -m src.week20_track1_al run)
outputs/week20_active_temporal_development/_cache/
# Joint depth-label study resumable caches (regenerated by python -m src.jdl_stage_m run)
outputs/joint_depth_label_development/_cache/
# Temporal SVGP scheduling locks (amendment T-A2; each fit row records its own thread count)
outputs/joint_depth_label_development/temporal_repair/locks/
# Continuation-runner single-instance handle and temporary state files
outputs/joint_depth_label_development/queue/runner.lock
outputs/joint_depth_label_development/queue/*.tmp
# One-shot recovery sequence locks
outputs/joint_depth_label_development/recovery/*/recovery.lock
# Coordinated pool runner lock
outputs/joint_depth_label_development/pool/pool_runner.lock
outputs/research_campaign_20261018/opus/_cache/
outputs/research_campaign_20261018/opus/runner/HEARTBEAT.json.tmp
outputs/research_campaign_20261018/opus/main/**/units/
outputs/research_campaign_20261018/opus/main/**/locks/
outputs/research_campaign_20261018/opus/temporal/**/units/
outputs/research_campaign_20261018/opus/temporal/**/locks/
outputs/research_campaign_20261018/opus/fixes/**/locks/
# RC18: per-unit checkpoint files (reproducible from frozen code; summarised in committed tables) and live runner state
outputs/research_campaign_20261018/opus/data/units/
outputs/research_campaign_20261018/opus/fixes/**/units/
outputs/research_campaign_20261018/opus/runner/runner.lock
outputs/research_campaign_20261018/opus/runner/HEARTBEAT.json
outputs/research_campaign_20261018/opus/runner/STATE.json
outputs/research_campaign_20261018/opus/runner/STATUS.md
# RC19 pooled campaign: per-unit checkpoints (reproducible from the frozen code), claim locks and live runner state
outputs/research_campaign_20261018/opus_pooled/**/units/
outputs/research_campaign_20261018/opus_pooled/**/locks/
outputs/research_campaign_20261018/opus_pooled/runner/runner.lock
